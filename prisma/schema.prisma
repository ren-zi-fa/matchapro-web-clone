generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model business_locations {
  idsbr              Int     @id

  nama_usaha         String
  alamat_usaha       String?

  kdprov             Int
  kdkab              Int
  kdkec              Int?
  kddesa             Int?

  nmprov             String
  nmkab              String
  nmkec              String?
  nmdesa             String?

  status_perusahaan  String

  latitude           Float?
  longitude          Float?
  latlong_status     String?
}


