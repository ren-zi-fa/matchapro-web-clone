generator client {
  provider        = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model business_locations {
  idsbr             String  @id
  nama_usaha        String
  alamat_usaha      String?
  kdprov            Int
  kdkab             Int
  kdkec             Int?
  kddesa            Int?
  nmprov            String
  nmkab             String
  nmkec             String?
  nmdesa            String?
  status_perusahaan String
  latitude          String?
  longitude         String?
  latlong_status    String?
  
  updatedBy         User?    @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedById       String?
  
  createdBy         User?    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById       String?
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  updatedLocations business_locations[] @relation("UpdatedBy")
  createdLocations business_locations[] @relation("CreatedBy")
}
